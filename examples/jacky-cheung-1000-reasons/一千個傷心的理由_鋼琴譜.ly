      \new Lyrics \with { \override LyricText.font-size = #-0.5 } \lyricsto "melody" \vocalLyrics
      \new Dynamics \dynamicsTrack
      \new Staff = "left" \leftHand
    >>
  >>
  \layout {
    #(layout-set-staff-size 17.5)
    \context {
      \Score
      \override BarNumber.font-size = #-2
    }
  }
}
